<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Truck Resale Value Calculator</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">

  <div class="bg-white shadow-2xl rounded-3xl p-8 w-full max-w-3xl">
    <h1 class="text-3xl font-bold text-center mb-2">
      Truck Resale Value Calculator
    </h1>

    <p class="text-center text-gray-500 mb-8">
      Advanced Commercial Vehicle Resale Formula
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

      <div>
        <label class="font-semibold">Purchase Price (₹)</label>
        <input id="purchasePrice" type="number" value="2000000"
          class="w-full mt-2 p-3 border rounded-xl" />
      </div>

      <div>
        <label class="font-semibold">Inflation Rate (%)</label>
        <input id="inflation" type="number" value="7"
          class="w-full mt-2 p-3 border rounded-xl" />
      </div>

      <div>
        <label class="font-semibold">Truck Age (Years)</label>
        <input id="years" type="number" value="7"
          class="w-full mt-2 p-3 border rounded-xl" />
      </div>

      <div>
        <label class="font-semibold">Age Factor (A)</label>
        <input id="ageFactor" type="number" step="0.01" value="0.50"
          class="w-full mt-2 p-3 border rounded-xl" />
      </div>

      <div>
        <label class="font-semibold">KM Factor (K)</label>
        <input id="kmFactor" type="number" step="0.01" value="0.90"
          class="w-full mt-2 p-3 border rounded-xl" />
      </div>

      <div>
        <label class="font-semibold">Condition Factor (C)</label>
        <input id="conditionFactor" type="number" step="0.01" value="1.00"
          class="w-full mt-2 p-3 border rounded-xl" />
      </div>

      <div>
        <label class="font-semibold">Market Demand Factor (M)</label>
        <input id="marketFactor" type="number" step="0.01" value="1.10"
          class="w-full mt-2 p-3 border rounded-xl" />
      </div>

    </div>

    <button onclick="calculateResale()"
      class="w-full mt-8 bg-black text-white py-4 rounded-2xl text-lg font-semibold hover:opacity-90 transition">
      Calculate Resale Value
    </button>

    <div class="mt-8 bg-gray-50 rounded-2xl p-6 border">

      <h2 class="text-2xl font-bold mb-4">Results</h2>

      <div class="space-y-3 text-lg">
        <p>
          Future New Truck Price:
          <span id="futurePrice" class="font-bold">₹0</span>
        </p>

        <p>
          Estimated Resale Value:
          <span id="resaleValue" class="font-bold text-green-600">₹0</span>
        </p>
      </div>

      <div class="mt-6 text-sm text-gray-600 bg-white p-4 rounded-xl border">
        <p class="font-semibold mb-2">Formula Used:</p>
        <p>
          RV = P(1 + i)^n × A × K × C × M
        </p>
      </div>
    </div>

    <div class="mt-8">
      <h3 class="text-xl font-bold mb-3">Factor Guide</h3>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse border text-sm">
          <thead class="bg-gray-100">
            <tr>
              <th class="border p-2">Factor</th>
              <th class="border p-2">Good</th>
              <th class="border p-2">Average</th>
              <th class="border p-2">Poor</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td class="border p-2">Age Factor</td>
              <td class="border p-2">0.55</td>
              <td class="border p-2">0.45</td>
              <td class="border p-2">0.30</td>
            </tr>

            <tr>
              <td class="border p-2">KM Factor</td>
              <td class="border p-2">1.00</td>
              <td class="border p-2">0.90</td>
              <td class="border p-2">0.75</td>
            </tr>

            <tr>
              <td class="border p-2">Condition Factor</td>
              <td class="border p-2">1.10</td>
              <td class="border p-2">1.00</td>
              <td class="border p-2">0.80</td>
            </tr>

            <tr>
              <td class="border p-2">Market Factor</td>
              <td class="border p-2">1.20</td>
              <td class="border p-2">1.00</td>
              <td class="border p-2">0.85</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    function formatCurrency(num) {
      return new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
      }).format(num);
    }

    function calculateResale() {
      const P = parseFloat(document.getElementById('purchasePrice').value);
      const i = parseFloat(document.getElementById('inflation').value) / 100;
      const n = parseFloat(document.getElementById('years').value);
      const A = parseFloat(document.getElementById('ageFactor').value);
      const K = parseFloat(document.getElementById('kmFactor').value);
      const C = parseFloat(document.getElementById('conditionFactor').value);
      const M = parseFloat(document.getElementById('marketFactor').value);

      const futurePrice = P * Math.pow((1 + i), n);

      const resaleValue = futurePrice * A * K * C * M;

      document.getElementById('futurePrice').innerText = formatCurrency(futurePrice);

      document.getElementById('resaleValue').innerText = formatCurrency(resaleValue);
    }

    calculateResale();
  </script>

</body>
</html>
